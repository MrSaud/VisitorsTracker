# Copy to /etc/visitorstracker.env, fill in, chmod 600, chown root:root.
# Referenced by visitorstracker.service.

# Required when DEBUG is off. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me

DJANGO_DEBUG=0

# The hostnames this serves. Comma-separated. Required when DEBUG is off.
DJANGO_ALLOWED_HOSTS=counter.example.com

# Set when nginx or an ALB terminates TLS in front of this. It turns on
# secure cookies and lets Django see the real scheme. Do not set it if
# nothing is terminating TLS: it would let a client claim https itself.
DJANGO_BEHIND_TLS_PROXY=1
DJANGO_SSL_REDIRECT=1
DJANGO_CSRF_TRUSTED_ORIGINS=https://counter.example.com
# Only once you are sure every subdomain is HTTPS, and start small (600).
DJANGO_HSTS_SECONDS=0

# Start every active camera when the service starts, and keep them running.
COUNTER_AUTOSTART=1
# 0 = retry a dropped camera forever, which is what an unattended box wants.
COUNTER_RECONNECT_ATTEMPTS=0

COUNTER_SITE_NAME=Main entrance
TZ=Asia/Kuwait

# Alerting. Without these nothing tells you the camera died.
# COUNTER_ALERTS_ENABLED=1
# COUNTER_ALERT_WEBHOOK=https://hooks.example.com/...
# COUNTER_ALERT_EMAILS=ops@example.com
